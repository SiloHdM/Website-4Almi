---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Story from '../components/Story.astro';
import Why from '../components/Why.astro';
import Sortiment from '../components/Sortiment.astro';
import Sponsoring from '../components/Sponsoring.astro';
import Community from '../components/Community.astro';
import Visit from '../components/Visit.astro';
import Footer from '../components/Footer.astro';
import QuickActions from '../components/QuickActions.astro';
---

<Base
  title="4Almi – Späti & Kiosk in Ludwigsburg, Mo–Sa bis 0 Uhr"
  description="4Almi in der Lindenstraße 8: der Späti in Ludwigsburg, der wirklich bis spät offen hat. Mo–Sa 9:30–0 Uhr. Snacks aus aller Welt, ausgefallene Drinks, Kaffee, Lotto, Hermes Paketshop und Lieferung über Wolt."
>
  <Header />
  <main id="inhalt">
    <Hero />
    <Story />
    <Why />
    <Sortiment />
    <Sponsoring />
    <Community />
    <Visit />
  </main>
  <Footer />
  <QuickActions />
</Base>
