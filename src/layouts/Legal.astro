---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Base title={`${title} – 4Almi Ludwigsburg`} description={`${title} von 4Almi, Lindenstraße 8, 71634 Ludwigsburg.`} noindex>
  <Header home={false} />
  <main id="inhalt" class="legal">
    <div class="wrap">
      <p class="draft">
        Vorlage: Dieser Rechtstext muss vor dem Livegang geprüft und vervollständigt werden.
      </p>
      <h1>{title}</h1>
      <div class="legal-body">
        <slot />
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .legal {
    padding-block: 8rem 5rem;
  }

  .draft {
    display: inline-block;
    margin-bottom: 2rem;
    padding: 0.6rem 1rem;
    border-radius: 10px;
    border: 1px solid rgb(216 36 36 / 0.6);
    background: rgb(216 36 36 / 0.1);
    font-size: 0.9375rem;
  }

  h1 {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
  }

  .legal-body {
    max-width: 68ch;
    margin-top: 2.5rem;
  }

  .legal-body :global(h2) {
    margin-top: 2.75rem;
    font-size: 1.5rem;
  }

  .legal-body :global(p),
  .legal-body :global(ul) {
    margin-top: 0.9rem;
    color: #d6d6d6;
  }

  .legal-body :global(a) {
    color: var(--blue-light);
  }

  .legal-body :global(.todo) {
    color: var(--red-light);
    font-weight: 600;
  }
</style>
