---
import { Image, Picture } from 'astro:assets';
import anfang from '../assets/media/anfang-kiosk-almi.jpeg';
import logo from '../assets/logo-4almi.png';

const steps = [
  {
    title: 'Ludwigsburg, schon als Jugendlicher',
    text: 'Schon in seiner Jugend war Almi viel in Ludwigsburg unterwegs, vor allem rund um den Marstall. Hier hat er seine Zeit verbracht, hier hat er Leute kennengelernt.',
  },
  {
    title: 'Ein Laden, der gefehlt hat',
    text: 'Was ihm damals immer gefehlt hat: ein Laden, in dem man abends noch alles bekommt und einfach mal stehen bleiben kann. Aus diesem eigenen Wunsch wurde die Idee für 4Almi.',
  },
  {
    title: 'Klein angefangen',
    text: 'Los ging es als „Kiosk Almi“ in der Kirchstraße. Ein kleiner Laden mit einem ganz anderen Sortiment als heute.',
  },
  {
    title: 'Gewachsen mit den Menschen',
    text: 'Die Leute kamen auf Almi zu: Kannst du das besorgen? Hast du auch das? Almi hat zugehört. Mit jedem Wunsch wurde das Sortiment größer, mit jeder Idee aus der Community wurde der Laden ein Stück mehr zu 4Almi.',
  },
  {
    title: 'Aus 22 Uhr wurde Mitternacht',
    text: 'Eigentlich wollte Almi nur bis 22 Uhr arbeiten. Doch immer mehr Kunden fragten, ob er nicht länger aufhaben kann, und viele wünschten sich einen Hermes-Service. Also hat er beides möglich gemacht: offen bis 24 Uhr und ein Hermes Paketshop im Laden.',
  },
];
---

<section class="section story" id="geschichte" aria-labelledby="geschichte-title">
  <div class="wrap">
    <h2 class="section-title" id="geschichte-title">
      Die Geschichte von <Image class="inline-logo" src={logo} alt="4Almi" width={420} />
    </h2>
    <p class="section-lead">
      4Almi ist nicht nach Plan entstanden. Die Menschen sind auf Almi zugekommen, und Stück für
      Stück ist daraus entstanden, was 4Almi heute ist.
    </p>

    <div class="story-grid">
      <ol class="steps">
        {
          steps.map((s) => (
            <li class="step reveal">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>

      <figure class="start-photo reveal">
        <Picture
          src={anfang}
          formats={['avif', 'webp']}
          widths={[480, 900]}
          sizes="(min-width: 900px) 40vw, 100vw"
          alt="Almi, damals noch mit Haaren, zeigt auf seinen ersten Laden mit dem Schild „Kiosk Almi“"
        />
        <figcaption>Ganz am Anfang: Almi vor dem alten Schild „Kiosk Almi“.</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .story-grid {
    display: grid;
    gap: 3rem;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    align-items: start;
  }

  .steps {
    display: grid;
    gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .step {
    position: relative;
    padding-left: 4.25rem;
    counter-increment: step;
  }

  .step::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: -0.15rem;
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 50%;
    border: 2px solid var(--blue);
    color: var(--blue-light);
    font-family: var(--font-display);
    font-weight: 850;
    font-size: 1.15rem;
  }

  .step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(1.45rem - 1px);
    top: 3.1rem;
    bottom: -2.3rem;
    width: 2px;
    background: linear-gradient(var(--blue), transparent);
  }

  .step h3 {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
  }

  .step p {
    margin-top: 0.5rem;
    max-width: 46ch;
    color: var(--muted);
  }

  .start-photo {
    margin: 0;
  }

  .start-photo :global(img) {
    width: 100%;
    border-radius: var(--radius-lg);
  }

  .start-photo figcaption {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  @media (min-width: 900px) {
    .story-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 5rem;
    }

    .start-photo {
      position: sticky;
      top: 6rem;
    }
  }
</style>
