---
import { Picture } from 'astro:assets';
import hoodie from '../assets/media/hoodie-chill-mal-ludwigsburg.jpeg';
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<section class="section community" id="community" aria-labelledby="community-title">
  <div class="wrap community-grid">
    <div>
      <h2 class="section-title" id="community-title">Nicht nur ein Kiosk. Eine Community.</h2>
      <p class="section-lead">
        Bei 4Almi trifft man sich. Nach der Schicht, nach dem Training, auf dem Heimweg oder einfach
        so. Man kennt sich, man redet, man lacht. Viele haben Almi zuerst auf TikTok oder Instagram
        gesehen und stehen dann irgendwann selbst im Laden, aus der ganzen Region.
      </p>
      <p class="section-lead">
        Genau diese Menschen haben 4Almi zu dem gemacht, was es heute ist.
      </p>

      <ul class="chips" aria-label="4Almi in sozialen Netzwerken">
        {
          site.socials.map((s) => (
            <li>
              <a class="chip" href={s.url} target="_blank" rel="noopener">
                <Icon name={s.label === 'TikTok' ? 'tiktok' : 'instagram'} />
                {s.handle}
                <span class="visually-hidden">auf {s.label} (öffnet in neuem Tab)</span>
              </a>
            </li>
          ))
        }
        <li>
          <span class="chip chip-soon">
            <Icon name="mic" />
            Podcast „Was geht Almi“ · bald
          </span>
        </li>
      </ul>
    </div>

    <figure class="hoodie">
      <Picture
        src={hoodie}
        formats={['avif', 'webp']}
        widths={[480, 800]}
        sizes="(min-width: 900px) 34vw, 100vw"
        alt="Person im schwarzen Hoodie mit dem Rückenaufdruck „Chill mal Ludwigsburg“ im Laden"
      />
      <figcaption>Chill mal, Ludwigsburg.</figcaption>
    </figure>
  </div>
</section>

<style>
  .community-grid {
    display: grid;
    gap: 3rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  /* Bewusst klein: Social Media ist ein Zusatz, nicht der Inhalt */
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.5rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 550;
    text-decoration: none;
    transition:
      color 150ms ease,
      border-color 150ms ease;
  }

  a.chip:hover {
    color: #fff;
    border-color: rgb(255 255 255 / 0.4);
  }

  .chip :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .chip-soon {
    border-style: dashed;
  }

  .hoodie {
    margin: 0;
  }

  .hoodie :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .hoodie figcaption {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  @media (min-width: 900px) {
    .community-grid {
      grid-template-columns: 1.4fr 1fr;
      gap: 5rem;
      align-items: center;
    }
  }
</style>
