---
import { Picture } from 'astro:assets';
import heroAlmi from '../assets/hero-almi.jpg';
import Icon from './Icon.astro';
import WoltLabel from './WoltLabel.astro';
import { site } from '../data/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-content">
    <p class="hero-kicker">Späti &amp; Kiosk in Ludwigsburg · {site.hoursShort}</p>

    <h1 class="hero-title" id="hero-title">
      <span class="line-1">Chill mal, Ludwigsburg.</span>
      <span class="line-2">Nicht nur ein Kiosk.</span>
    </h1>

    <p class="hero-text">
      Angefangen hat alles ganz klein, mit einem anderen Sortiment und einem schlichten Laden. Was
      4Almi heute ist, ist mit den Menschen aus Ludwigsburg gewachsen: mit ihren Wünschen, ihren
      Ideen und ihrer Unterstützung.
    </p>

    <div class="hero-ctas">
      <a class="btn btn-wolt" href={site.wolt} target="_blank" rel="noopener">
        <WoltLabel />
      </a>
      <a class="btn btn-ghost" href="#besuch">
        <Icon name="map-pin" />
        Vorbeikommen
      </a>
    </div>
  </div>

  <div class="hero-photo">
    <Picture
      src={heroAlmi}
      formats={['avif', 'webp']}
      widths={[400, 600]}
      sizes="(min-width: 900px) 38vw, 100vw"
      alt="Taylan „Almi“ Tepeoglu im Laden, mit einem 4Almi-Trikot in der Hand"
      loading="eager"
    />
  </div>
</section>

<style>
  .hero {
    display: grid;
    width: min(100% - 2 * var(--gutter), var(--max));
    margin-inline: auto;
    padding-block: clamp(3rem, 7vw, 6rem) clamp(2rem, 5vw, 4rem);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero-kicker {
    color: var(--muted);
    font-size: 1rem;
    font-weight: 550;
    animation: rise 800ms 100ms var(--ease-out) both;
  }

  /* Die prägende Aussage, sofort sichtbar */
  .hero-title {
    display: grid;
    margin-top: 1rem;
    font-size: clamp(2.75rem, 7.2vw, 6.25rem);
    line-height: 0.95;
  }

  .hero-title span {
    animation: rise 900ms var(--ease-out) both;
  }

  .hero-title .line-1 {
    color: var(--text);
    animation-delay: 200ms;
  }

  .hero-title .line-2 {
    color: var(--red);
    animation-delay: 320ms;
  }

  .hero-text {
    margin-top: 1.75rem;
    max-width: 38rem;
    color: var(--muted);
    font-size: clamp(1.125rem, 1.6vw, 1.3rem);
    line-height: 1.55;
    animation: rise 900ms 450ms var(--ease-out) both;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
    animation: rise 900ms 550ms var(--ease-out) both;
  }

  .hero-photo {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    animation: photo-in 1200ms 150ms var(--ease-out) both;
  }

  .hero-photo :global(picture) {
    display: block;
    height: 100%;
  }

  .hero-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.5em);
    }
  }

  @keyframes photo-in {
    from {
      opacity: 0;
      transform: scale(1.03);
    }
  }

  @media (max-width: 899px) {
    .hero-photo {
      height: 70svh;
      max-height: 34rem;
    }

    .hero-photo :global(img) {
      object-position: 72% 20%;
    }

    .hero-ctas .btn {
      flex: 1 1 14rem;
    }
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    }

    .hero-photo {
      height: min(78svh, 46rem);
    }
  }
</style>
