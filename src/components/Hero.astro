---
import { Image, Picture } from 'astro:assets';
import heroAlmi from '../assets/hero-almi.jpg';
import logo from '../assets/logo-4almi.png';
import Icon from './Icon.astro';
import WoltLabel from './WoltLabel.astro';
import { site } from '../data/site';

// Zeilen für die Schreibmaschine. Die erste ist der Claim aus Social Media.
const lines = [site.claim, 'Mo–Sa bis 0 Uhr offen.', 'Chill mal, Ludwigsburg.'];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-photo">
    <Picture
      src={heroAlmi}
      formats={['avif', 'webp']}
      widths={[400, 600]}
      sizes="(min-width: 900px) 40vw, 100vw"
      alt="Taylan „Almi“ Tepeoglu im Laden, mit einem 4Almi-Trikot in der Hand"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="hero-content">
    <p class="hero-kicker">Späti &amp; Kiosk in Ludwigsburg</p>

    <h1 class="wordmark" id="hero-title">
      <Image src={logo} alt="4Almi" widths={[640, 895]} sizes="(min-width: 900px) 44vw, 86vw" loading="eager" />
    </h1>

    <p class="typed">
      <span class="visually-hidden">{site.claim}</span>
      <span class="typed-text" aria-hidden="true" data-typed data-lines={JSON.stringify(lines)}>{lines[0]}</span><span class="caret" aria-hidden="true"></span>
    </p>

    <p class="hero-text">
      Snacks aus aller Welt, ausgefallene Drinks, Kaffee, Lotto und Hermes-Paketshop. Mitten in
      Ludwigsburg, Montag bis Samstag bis Mitternacht.
    </p>

    <div class="hero-ctas">
      <a class="btn btn-wolt" href={site.wolt} target="_blank" rel="noopener">
        <WoltLabel />
      </a>
      <a class="btn btn-ghost" href="#besuch">
        <Icon name="map-pin" />
        Vorbeikommen
      </a>
    </div>
  </div>

  <a class="scroll-hint" href="#geschichte">
    Zur Geschichte
    <Icon name="chevron-down" />
  </a>
</section>

<script>
  // Schreibmaschinen-Effekt. Ohne JS oder mit reduzierter Bewegung bleibt der Claim stehen.
  const el = document.querySelector<HTMLElement>('[data-typed]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (el && !reduce) {
    const lines: string[] = JSON.parse(el.dataset.lines ?? '[]');
    let line = 0;
    let pos = 0;
    let deleting = false;
    el.textContent = '';

    const tick = () => {
      const text = lines[line];
      if (!deleting) {
        pos++;
        el.textContent = text.slice(0, pos);
        if (pos === text.length) {
          deleting = true;
          return setTimeout(tick, 2600);
        }
        return setTimeout(tick, 55 + Math.random() * 50);
      }
      pos--;
      el.textContent = text.slice(0, pos);
      if (pos === 0) {
        deleting = false;
        line = (line + 1) % lines.length;
        return setTimeout(tick, 350);
      }
      return setTimeout(tick, 28);
    };

    setTimeout(tick, 900);
  }
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: 100svh;
    overflow: hidden;
  }

  .hero-photo {
    position: relative;
    overflow: hidden;
  }

  .hero-photo :global(picture) {
    display: block;
    height: 100%;
  }

  .hero-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%;
    animation: photo-in 1400ms var(--ease-out) both;
  }

  /* Foto läuft nach rechts und unten ins Schwarz aus */
  .hero-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, transparent 55%, var(--black)),
      linear-gradient(to bottom, transparent 60%, var(--black));
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 7rem var(--gutter) 6rem;
  }

  .hero-kicker {
    color: var(--muted);
    font-size: 1rem;
    font-weight: 550;
    letter-spacing: 0.02em;
    animation: rise 900ms 200ms var(--ease-out) both;
  }

  /* Das eine laute Element: das echte 4Almi-Logo, groß */
  .wordmark {
    margin-top: 1rem;
  }

  .wordmark :global(img) {
    width: min(100%, 40rem);
    height: auto;
    margin-left: -0.6%;
    animation: rise 1000ms 300ms var(--ease-out) both;
  }

  /* zwei Zeilen reservieren, damit beim Tippen nichts springt */
  .typed {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    min-height: 1.15em;
    white-space: nowrap;
    font-family: var(--font-display);
    font-stretch: 110%;
    font-weight: 850;
    font-size: clamp(1.5rem, 2.5vw, 2.4rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    animation: rise 900ms 600ms var(--ease-out) both;
  }

  .caret {
    display: inline-block;
    width: 0.09em;
    height: 0.95em;
    margin-left: 0.06em;
    vertical-align: -0.1em;
    background: var(--red);
    animation: blink 1s steps(1) infinite;
  }

  .hero-text {
    margin-top: 1.25rem;
    max-width: 34rem;
    color: var(--muted);
    font-size: clamp(1.0625rem, 1.4vw, 1.2rem);
    animation: rise 900ms 700ms var(--ease-out) both;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
    animation: rise 900ms 800ms var(--ease-out) both;
  }

  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    z-index: 1;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 1rem;
    translate: -50% 0;
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 550;
    text-decoration: none;
  }

  .scroll-hint :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    animation: nudge 2.2s ease-in-out infinite;
  }

  .scroll-hint:hover {
    color: #fff;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.4em);
    }
  }

  @keyframes photo-in {
    from {
      opacity: 0;
      transform: scale(1.06);
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @keyframes nudge {
    50% {
      transform: translateY(4px);
    }
  }

  /* Handy: Foto oben, Schriftzug überlappt die Unterkante */
  @media (max-height: 820px) {
    .scroll-hint {
      display: none;
    }
  }

  @media (max-width: 899px) {
    .typed {
      white-space: normal;
      min-height: 2.3em;
    }

    .hero {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto;
    }

    .hero-photo :global(img) {
      object-position: 72% 20%;
    }

    .hero-photo {
      height: 62svh;
      min-height: 22rem;
    }

    .hero-photo::after {
      background: linear-gradient(to bottom, rgb(0 0 0 / 0.35), transparent 25%, transparent 50%, var(--black));
    }

    .hero-content {
      margin-top: -5.5rem;
      padding-top: 0;
      padding-bottom: 5.5rem;
    }

    .wordmark :global(img) {
      width: min(86vw, 26rem);
    }

    .hero-ctas .btn {
      flex: 1 1 14rem;
    }

    .scroll-hint {
      display: none;
    }
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    }

    .hero-photo {
      height: 100svh;
    }

    .hero-content {
      padding-left: clamp(1rem, 4vw, 4rem);
    }
  }
</style>
