---
import { Picture } from 'astro:assets';
import lkz from '../assets/media/presse-lkz.jpeg';
import sz from '../assets/media/presse-stuttgarter-zeitung.jpeg';
import Icon from './Icon.astro';
import { site } from '../data/site';

const press = [
  {
    src: lkz,
    paper: 'Ludwigsburger Kreiszeitung',
    headline: 'Der Späti als Gesamtkunstwerk',
    url: site.press.lkz,
    alt: 'Zeitungsausschnitt der Ludwigsburger Kreiszeitung über Kiosk Almi mit Foto von Almi vor seinem Laden',
  },
  {
    src: sz,
    paper: 'Stuttgarter Zeitung',
    headline: 'Der Späti-Mann, der alles besorgen kann',
    url: site.press.stuttgarterZeitung,
    alt: 'Zeitungsausschnitt der Stuttgarter Zeitung über 4Almi mit Foto von Almi vor dem Laden',
  },
];
---

<section class="section ludwigsburg" id="ludwigsburg" aria-labelledby="ludwigsburg-title">
  <div class="wrap">
    <h2 class="section-title" id="ludwigsburg-title">Seine Stadt. Seine Leute.</h2>
    <div class="love">
      <p class="section-lead">
        Almi liebt Ludwigsburg. Weil ihn die Menschen hier so herzlich aufgenommen haben. Er liebt die
        Stadt, ihre Leute und das, was zwischen ihnen und ihm entstanden ist.
      </p>
      <p class="section-lead">
        Durch 4Almi kennt man ihn inzwischen in ganz Ludwigsburg. Und auch die Zeitungen haben über
        ihn geschrieben.
      </p>
    </div>

    <ul class="press">
      {
        press.map((p) => (
          <li class="reveal">
            <a href={p.url} target="_blank" rel="noopener">
              <Picture
                src={p.src}
                formats={['avif', 'webp']}
                widths={[480, 900]}
                sizes="(min-width: 900px) 36rem, 100vw"
                alt={p.alt}
              />
              <span class="press-meta">
                <span class="press-paper">{p.paper}</span>
                <span class="press-headline">
                  „{p.headline}“
                  <Icon name="external" />
                </span>
                <span class="visually-hidden">(Artikel öffnet in neuem Tab)</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .love {
    display: grid;
    gap: 0 3rem;
  }

  .press {
    display: grid;
    gap: 1.5rem;
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .press a {
    display: grid;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--raised);
    text-decoration: none;
    transition: border-color 150ms ease;
  }

  .press a:hover {
    border-color: rgb(255 255 255 / 0.4);
  }

  .press :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: calc(var(--radius-lg) - 0.75rem);
    background: #fff;
  }

  .press-meta {
    display: grid;
    gap: 0.2rem;
    padding: 0 0.25rem 0.25rem;
  }

  .press-paper {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .press-headline {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .press-headline :global(svg) {
    flex: none;
    width: 1rem;
    height: 1rem;
    color: var(--muted);
  }

  @media (min-width: 700px) {
    .press {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 900px) {
    .love {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
